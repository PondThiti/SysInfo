<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*"
             Name="System Storage &amp; Port Inspector"
             Language="1033"
             Version="0.0.3.0"
             Manufacturer="SysPulse"
             UpgradeCode="B6A87432-84F1-4F2A-949B-E412581699AB">
        
        <Package InstallerVersion="200"
                 Compressed="yes"
                 InstallScope="perMachine"
                 Platform="x64"
                 Description="System Storage &amp; Port Inspector Setup"
                 Comments="SysPulse All-in-One PC Utility with Complete Uninstaller" />

        <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
        <MediaTemplate EmbedCab="yes" />

        <!-- Suppress any reboot prompts and disable restart manager triggers -->
        <Property Id="REBOOT" Value="ReallySuppress" />
        <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />

        <!-- Application Icon -->
        <Icon Id="AppIcon.ico" SourceFile="build\icon.ico" />
        <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
        <Property Id="ARPHELPLINK" Value="https://github.com/SysPulse" />

        <!-- Directory Structure -->
        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="INSTALLFOLDER" Name="System Storage &amp; Port Inspector" />
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="System Storage &amp; Port Inspector" />
            </Directory>
            <Directory Id="DesktopFolder" Name="Desktop" />
        </Directory>

        <!-- Shortcuts Component -->
        <DirectoryRef Id="ApplicationProgramsFolder">
            <Component Id="ApplicationShortcut" Guid="{E82C8724-4B39-44F1-8B89-722E34629A10}">
                <Shortcut Id="ApplicationStartMenuShortcut"
                          Name="System Storage &amp; Port Inspector"
                          Description="All-in-One Storage Analyzer, Smart Junk Cleaner &amp; Port Inspector"
                          Target="[INSTALLFOLDER]System Storage &amp; Port Inspector.exe"
                          WorkingDirectory="INSTALLFOLDER"
                          Icon="AppIcon.ico" />
                <Shortcut Id="ApplicationDesktopShortcut"
                          Directory="DesktopFolder"
                          Name="System Storage &amp; Port Inspector"
                          Description="All-in-One Storage Analyzer, Smart Junk Cleaner &amp; Port Inspector"
                          Target="[INSTALLFOLDER]System Storage &amp; Port Inspector.exe"
                          WorkingDirectory="INSTALLFOLDER"
                          Icon="AppIcon.ico" />
                <!-- Dedicated Clean Uninstaller Shortcut in Start Menu without Reboot -->
                <Shortcut Id="UninstallProductShortcut"
                          Name="Uninstall System Storage &amp; Port Inspector"
                          Description="Uninstall System Storage &amp; Port Inspector cleanly and completely"
                          Target="[System64Folder]msiexec.exe"
                          Arguments="/x [ProductCode] REBOOT=ReallySuppress"
                          Icon="AppIcon.ico" />
                <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
                <RegistryKey Root="HKCU" Key="Software\SysPulse" ForceDeleteOnUninstall="yes">
                    <RegistryValue Type="string" Value="SysPulse" KeyPath="yes" />
                </RegistryKey>
            </Component>
        </DirectoryRef>

        <!-- Thorough Folder Cleanup Component -->
        <DirectoryRef Id="INSTALLFOLDER">
            <Component Id="CleanUpInstallFolderComp" Guid="{7F89E82B-5BC3-431B-8239-0192A9388123}">
                <CreateFolder />
                <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
                <RegistryValue Root="HKCU" Key="Software\SysPulse\SystemStoragePortInspector" Name="clean_folder" Type="integer" Value="1" KeyPath="yes" />
                <RegistryValue Root="HKLM" Key="Software\SysPulse\SystemStoragePortInspector" Name="ProductCode" Type="string" Value="[ProductCode]" />
            </Component>
        </DirectoryRef>

        <!-- Terminate running app before installation/uninstallation so no files are held in use -->
        <CustomAction Id="KillRunningApp"
                      Directory="TARGETDIR"
                      ExeCommand="cmd.exe /c taskkill /F /IM &quot;System Storage &amp; Port Inspector.exe&quot; /T"
                      Execute="immediate"
                      Return="ignore" />

        <InstallExecuteSequence>
            <Custom Action="KillRunningApp" Before="InstallValidate" />
        </InstallExecuteSequence>

        <!-- Features -->
        <Feature Id="ProductFeature" Title="System Storage &amp; Port Inspector" Level="1">
            <ComponentGroupRef Id="AppFiles" />
            <ComponentRef Id="ApplicationShortcut" />
            <ComponentRef Id="CleanUpInstallFolderComp" />
        </Feature>

        <!-- User Interface -->
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
        <UIRef Id="WixUI_InstallDir" />
        <WixVariable Id="WixUILicenseRtf" Value="wix\license.rtf" />

    </Product>
</Wix>
